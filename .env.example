# Environment Variables for Christina Flanding Website
# In Cloudflare Pages: Settings → Variables and Secrets (Production)
# Do not put real keys in this file — it is committed to git.

# 1. Resend API key (resend.com) — add as a Secret, not a plain variable
RESEND_API_KEY="re_your_api_key_here"

# 2. Where Christina receives booking alerts
HEALER_EMAIL="christina@example.com"

# 3. Sender (use onboarding@resend.dev until a custom domain is verified)
# With onboarding@resend.dev, Resend only delivers to the email on the Resend account.
FROM_EMAIL="Christina Flanding <onboarding@resend.dev>"

# 4. Optional fallback if using Web3Forms
WEB3FORMS_ACCESS_KEY="YOUR_ACCESS_KEY_HERE"
