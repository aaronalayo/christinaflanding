# Environment Variables for Christina Flanding Website
# In Cloudflare Pages: Add these under Settings -> Environment variables

# 1. Resend API Key for sending confirmation & notification emails (from resend.com)
RESEND_API_KEY="re_your_api_key_here"

# 2. Healer notification email address (where Christina receives booking alerts)
HEALER_EMAIL="christina@example.com"

# 3. Sender address (defaults to onboarding@resend.dev until custom domain is verified)
FROM_EMAIL="Christina Flanding <onboarding@resend.dev>"

# 4. Optional fallback if using Web3Forms
WEB3FORMS_ACCESS_KEY="YOUR_ACCESS_KEY_HERE"

